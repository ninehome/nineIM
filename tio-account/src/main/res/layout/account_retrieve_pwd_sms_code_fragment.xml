<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.text.TextUtils" />

        <variable
            name="data"
            type="com.tiocloud.account.feature.retrieve_pwd.SmsCodeFragment" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--状态栏-->
        <FrameLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--顶部底图-->
        <ImageView
            android:id="@+id/iv_top_bg"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:background="@drawable/account_page_top_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />

        <!--logo-->
        <TextView
            android:id="@+id/tv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="43dp"
            android:drawableTop="@drawable/account_ic_logo"
            android:drawablePadding="16dp"
            android:gravity="center_horizontal"
            android:text="@string/app_name"
            android:textColor="#666666"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_top_bg" />

        <!--标题栏-->
        <com.watayouxiang.androidutils.widget.WtTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar"
            app:tb_background="@color/transparent"
            app:tb_tvTitle_text="返回" />

        <!--标题-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="57dp"
            android:layout_marginTop="52dp"
            android:text="@string/get_code"
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_top_bg" />

        <!--验证码-->
        <com.watayouxiang.androidutils.widget.TioShadowLayout
            android:id="@+id/ll_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="92dp"
            android:layout_marginRight="36dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_top_bg">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.watayouxiang.androidutils.widget.edittext.TioEditText
                    android:id="@+id/et_code"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/account_sel_et"
                    android:drawableLeft="@drawable/account_ic_safe"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_input_code"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:paddingRight="100dp"
                    android:singleLine="true"
                    android:text="@={data.txt_code}"
                    android:textColor="#333333"
                    android:textColorHint="#D5D5D5"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_reqPhoneCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:enabled="@{!data.isStartTimer}"
                    android:onClick="@{data.onClick_reqPhoneCode}"
                    android:padding="5dp"
                    android:text="@string/get_code"
                    android:textColor="@color/account_sel_code_timer_txt_color"
                    android:textSize="14sp" />
            </RelativeLayout>
        </com.watayouxiang.androidutils.widget.TioShadowLayout>

        <!--注册-->
        <com.watayouxiang.androidutils.widget.TioShadowLayout
            android:id="@+id/ll_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_code">

            <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="@{!TextUtils.isEmpty(data.txt_code)}"
                android:gravity="center"
                android:onClick="@{data.onClick_ok}"
                android:text="@string/next_step"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:qmui_backgroundColor="@color/account_sel_ok_bg_color"
                app:qmui_borderColor="@color/transparent"
                app:qmui_borderWidth="0px"
                app:qmui_radius="24dp" />
        </com.watayouxiang.androidutils.widget.TioShadowLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>