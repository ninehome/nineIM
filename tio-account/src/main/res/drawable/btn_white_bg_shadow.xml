<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item >
        <shape android:shape="rectangle">
            <padding
                android:left="1dp"
                android:right="1dp"
                android:bottom="3dp"
                android:top="1dp"
                />
            <solid android:color="#08EFEFEF" />
            <corners android:radius="@dimen/dp_30" />
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle">
            <padding
                android:left="0.7dp"
                android:right="0.7dp"
                android:bottom="2dp"
                android:top="0.7dp"
                />
            <solid android:color="#10EFEFEF" />
            <corners android:radius="@dimen/dp_30" />
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle">
            <padding
                android:left="0.5dp"
                android:right="0.5dp"
                android:bottom="@dimen/dp_xu_all"
                android:top="0.5dp"
                />
            <solid android:color="#20EFEFEF" />
            <corners android:radius="@dimen/dp_30" />
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_30" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>