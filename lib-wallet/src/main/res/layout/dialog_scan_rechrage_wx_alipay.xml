<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fillet_dialog_bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/close_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:padding="2dp"
            android:src="@mipmap/delete_icon_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/get_money_code"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_18_text_size" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.watayouxiang.androidutils.widget.imageview.TioImageView
            android:id="@+id/code_iv"
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            tools:src="@mipmap/qr_code_icon" />

        <TextView
            android:id="@+id/save_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:background="@drawable/selector_theme_line_color_bg"
            android:paddingStart="24dp"
            android:paddingTop="7dp"
            android:paddingEnd="24dp"
            android:paddingBottom="7dp"
            android:text="@string/rp_receipt_tip4"
            android:textColor="@color/theme_color"
            android:textStyle="bold"
            android:textSize="@dimen/sp_14_text_size" />

        <TextView
            android:id="@+id/tip_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="@string/scan_recharge_wx_alipay_tip1"
            android:textColor="@color/gray_666666"
            android:textSize="@dimen/sp_15_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="2dp"
            android:paddingRight="20dp"
            android:layout_marginTop="@dimen/dp_5"
            android:paddingBottom="9dp"
            android:text="@string/scan_recharge_wx_alipay_tip2"
            android:textColor="@color/gray_666666"
            android:textSize="@dimen/sp_15_text_size" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_24"
        android:paddingLeft="@dimen/dp_20"
        android:paddingRight="@dimen/dp_20">

        <TextView
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:background="@drawable/scan_recharge_dialog_white"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/Grey_600"
            android:textSize="@dimen/sp_18_text_size" />

        <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
            android:id="@+id/confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/dp15"
            app:qmui_backgroundColor="@color/account_sel_ok_bg_color"
            app:qmui_borderColor="@color/transparent"
            app:qmui_borderWidth="0px"
            app:qmui_radius="30dp"
            android:gravity="center"
            android:text="@string/sure"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16_text_size" />

    </LinearLayout>

</LinearLayout>