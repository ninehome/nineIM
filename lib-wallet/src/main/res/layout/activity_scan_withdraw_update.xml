<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical">

    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tb_background="@color/white"
        app:tb_tvTitle_text="@string/chongzhi" />

    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fillet_dialog_bg"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/resume_star_icon"
                android:text="@string/select_withdraw_alipay_name"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/alipay_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_name"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

        <View
            style="@style/View_Line"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/resume_star_icon"
                android:text="@string/select_withdraw_alipay_account"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/alipay_account_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_account"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fillet_dialog_bg"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/resume_star_icon"
                android:text="@string/select_withdraw_band_card_name"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/band_card_owner_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_name"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

        <View
            style="@style/View_Line"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/resume_star_icon"
                android:text="@string/select_withdraw_band_card_account"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/band_card_account_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_band_card_account"
                android:inputType="number"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

        <View
            style="@style/View_Line"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/resume_star_icon"
                android:text="@string/select_withdraw_band_name"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/band_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_band"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

        <View
            style="@style/View_Line"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/select_withdraw_band_son_name"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/band_son_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/select_withdraw_band_son_name_hint"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

        <View
            style="@style/View_Line"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/select_withdraw_band_remark"
                android:textColor="@color/gray_333333"
                android:textSize="@dimen/sp_16_text_size" />

            <EditText
                android:id="@+id/band_card_remark_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/rename_align"
                android:paddingTop="5dp"
                android:paddingEnd="15dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:paddingStart="@dimen/dp_14"
                android:textColor="@color/black"
                android:textColorHint="#FFC6C8CC"
                android:textSize="@dimen/sp_16_text_size" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/sure_update_btn"
        style="@style/BossGreenBtn"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginRight="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_31"
        android:text="@string/save" />

    <Button
        android:id="@+id/sure_delete_btn"
        style="@style/BossGreenBtn"
        android:background="@drawable/bg_btn_grey"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="24dp"
        android:textColor="#FFFF4D4D"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginRight="@dimen/dp_30"
        android:text="@string/delete" />

</LinearLayout>
