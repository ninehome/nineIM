<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_add"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_64"
    android:layout_marginStart="15dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="15dp"
    android:background="@drawable/fillet_dialog_bg"
    android:padding="15dp">

    <TextView
        android:id="@+id/add_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/black"
        android:drawableLeft="@drawable/icon_add24"
        android:textStyle="bold"
        android:drawablePadding="@dimen/dp_12"
        android:textSize="@dimen/sp_16_text_size"
        android:visibility="gone"
        tools:text="@string/select_withdraw_add_alipay_account" />
    <View
        android:id="@+id/cc"
        android:layout_width="@dimen/dp40"
        android:layout_height="1dp"/>
    <ImageView
        android:id="@+id/type_iv"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_toRightOf="@id/cc"
        android:layout_centerVertical="true"
        tools:src="@drawable/icon_pay01" />

    <TextView
        android:id="@+id/type_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/type_iv"
        android:singleLine="true"
        android:textColor="#FF2E2F33"
        android:layout_marginLeft="@dimen/dp_15"
        android:drawablePadding="@dimen/dp_15"
        android:textSize="@dimen/sp_16_text_size"
        tools:text="中国银行（6659）" />

    <ImageView
        android:id="@+id/next_iv"
        style="@style/basic_info"
        android:background="@drawable/btn_edit16"
        android:layout_marginRight="@dimen/dp_20"
        android:contentDescription="@string/app_name" />

</RelativeLayout>
