<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/dp40"
        app:tb_background="@color/transparent"
        app:tb_isLightMode="true"
        app:tb_tvTitle_text="收款" />
    <ImageView
        android:id="@+id/iv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        android:layout_marginTop="@dimen/dp40"
        android:src="@drawable/icon_waiting"
        />

    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv1"
        android:textSize="@dimen/sp_14"
        android:textColor="#252A31"
        android:text="@string/dainishoukuan"
        />
    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@id/tv1"
        android:gravity="center"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="￥"
            android:textColor="@color/black"
            android:textSize="@dimen/font_32"
            android:textStyle="bold"
            android:layout_marginLeft="@dimen/dp_20"
            />
        <TextView
            android:id="@+id/et_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp5"
            android:textStyle="bold"
            android:background="@null"
            android:maxLength="6"
            android:textSize="48sp"
            android:textColor="@color/black"
            tools:text="100"
            />
    </LinearLayout>

    <View
        android:id="@+id/vline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_48"
        app:layout_constraintTop_toBottomOf="@id/ll1"
        android:background="@color/gray_e9e9e9"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        />

    <LinearLayout
        android:id="@+id/ll2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/vline"
        android:orientation="horizontal"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_15"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_999999"
            android:textSize="@dimen/sp_12"
            android:text="@string/zhuanzhangshijian"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/trans_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12_text_size"
            tools:text="2021年07月20日 12:08:23"/>
    </LinearLayout>


    <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
        android:id="@+id/btnSure"
        android:layout_width="@dimen/dp_195"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/shoukuan"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginTop="@dimen/dp_120"
        app:qmui_backgroundColor="@color/account_sel_ok_bg_color"
        app:qmui_borderColor="@color/transparent"
        app:qmui_borderWidth="0px"
        app:qmui_radius="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll2"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnSure"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_24"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_999999"
            android:textSize="@dimen/sp_12"
            android:text="@string/yitiannei"/>
        <TextView
            android:id="@+id/to_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#748499"
            android:textSize="@dimen/sp_12_text_size"
            android:text="@string/tuihuan"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>