<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="2dp"
        android:text="@string/tuijian"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/v_line"
        android:layout_width="20dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/wallet_redpacket_tab_item_line_bg"
        app:layout_constraintEnd_toEndOf="@+id/tv_txt"
        app:layout_constraintStart_toStartOf="@+id/tv_txt"
        app:layout_constraintTop_toBottomOf="@+id/tv_txt" />

</androidx.constraintlayout.widget.ConstraintLayout>