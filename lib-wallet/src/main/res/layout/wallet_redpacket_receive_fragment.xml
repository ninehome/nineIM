<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.watayouxiang.wallet.feature.redpacket.feature.receive.ReceiveFragment" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:orientation="vertical"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <!--<<< 折叠区 >>>-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--背景-->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!--头像-->
                    <FrameLayout
                        android:id="@+id/fl_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.watayouxiang.androidutils.widget.imageview.TioImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="80dp"
                            app:roundAsCircle="true"
                            android:layout_height="80dp"
                            app:roundingBorderColor="@color/white"
                            app:roundingBorderWidth="2.5dp"
                            />
                    </FrameLayout>

                    <!--用户信息-->
                    <TextView
                        android:id="@+id/tv_userInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@{data.userInfo}"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/fl_avatar" />

                    <!--金额-->
                    <TextView
                        android:id="@+id/tv_money"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@{data.money}"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/sp_36"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_userInfo" />

                    <!--元-->
                    <TextView
                        android:id="@+id/tv_yuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/yuan"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_16"
                        app:layout_constraintBottom_toBottomOf="@id/tv_money"
                        app:layout_constraintStart_toEndOf="@id/tv_money" />
                    <TextView
                        android:id="@+id/tv_amount_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:layout_marginBottom="22dp"
                        android:text="@{data.packetAmount}"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_24"
                        tools:text="11"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_amount_right"
                        app:layout_constraintTop_toBottomOf="@id/tv_money"
                        />
                    <TextView
                        android:id="@+id/tv_amount_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@{data.bestAmount}"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_24"
                        tools:text="11"
                        app:layout_constraintBottom_toBottomOf="@id/tv_amount_left"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_amount_left"
                        app:layout_constraintStart_toEndOf="@id/tv_amount_left"
                        />
                    <TextView
                        android:id="@+id/tv_tip_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/shoudaohongbaoshu"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_amount_left"
                        app:layout_constraintStart_toStartOf="@id/tv_amount_left"
                        app:layout_constraintTop_toBottomOf="@id/tv_amount_left"
                        android:layout_marginBottom="@dimen/dp_24"
                        />
                    <TextView
                        android:id="@+id/tv_tip_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="人品爆发"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_14"
                        app:layout_constraintEnd_toEndOf="@id/tv_amount_right"
                        app:layout_constraintStart_toStartOf="@id/tv_amount_right"
                        app:layout_constraintTop_toBottomOf="@id/tv_amount_right"/>
                    <!--&lt;!&ndash;左侧数字&ndash;&gt;
                    <TextView
                        android:id="@+id/tv_amount_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginBottom="22dp"
                        android:text="@{data.packetAmount}"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_tip_left"
                        app:layout_constraintStart_toStartOf="@id/tv_tip_left"
                        app:layout_constraintTop_toBottomOf="@id/tv_tip_left" />
                    &lt;!&ndash;左侧提示&ndash;&gt;
                    <TextView
                        android:id="@+id/tv_tip_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        android:text="收到红包数"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_14"
                        app:layout_constraintEnd_toStartOf="@id/tv_tip_right"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_money" />

                    &lt;!&ndash;右侧提示&ndash;&gt;
                    <TextView
                        android:id="@+id/tv_tip_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人品爆发"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_14"
                        app:layout_constraintBottom_toBottomOf="@id/tv_tip_left"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_tip_left"
                        app:layout_constraintTop_toTopOf="@id/tv_tip_left" />



                    &lt;!&ndash;右侧数字&ndash;&gt;
                    <TextView
                        android:id="@+id/tv_amount_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@{data.bestAmount}"
                        android:textColor="@color/gray_666666"
                        android:textSize="@dimen/sp_20"
                        app:layout_constraintEnd_toEndOf="@id/tv_tip_right"
                        app:layout_constraintStart_toStartOf="@id/tv_tip_right"
                        app:layout_constraintTop_toBottomOf="@id/tv_tip_right" />-->

                    <!--底部分割线-->
                  <!--  <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:background="#F8F8F8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />-->

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <!--<<< 悬浮区 >>>-->
        </com.google.android.material.appbar.AppBarLayout>

        <!--<<< 内容区 >>>-->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>