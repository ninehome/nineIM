<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">
    <!--标题栏-->
    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/dp40"
        app:tb_background="#F7F8FA"
        app:tb_isLightMode="true"
        app:tb_tvTitle_text="@string/zhuanzhang" />

    <com.watayouxiang.androidutils.widget.imageview.TioImageView
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/dp60"
        android:layout_height="@dimen/dp60"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="2dp" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_14_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_avatar"
        tools:text="达牛(元)" />

    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_24"
        android:background="@drawable/shape_round_white_bg_c12"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_name">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/zhuanzhangjine"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_16_text_size"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="￥"
                android:textColor="@color/black"
                android:textSize="@dimen/font_32"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/dp_20"
                />
            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:textStyle="bold"
                android:background="@null"
                android:maxLength="6"
                android:textSize="48sp"
                android:inputType="numberDecimal"
                android:focusable="true"
                android:defaultFocusHighlightEnabled="true"
                android:focusableInTouchMode="true"
                android:focusedByDefault="true"
                android:textColor="@color/black"
                tools:text="100"
                />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_add_remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tianjiazhuangzhang"
        android:layout_marginTop="@dimen/dp_16"
        android:textSize="@dimen/sp_14_text_size"
        android:textColor="#252A31"
        app:layout_constraintStart_toStartOf="@id/ll1"
        app:layout_constraintTop_toBottomOf="@id/ll1"
        />

    <com.qmuiteam.qmui.widget.roundwidget.QMUIRoundButton
        android:id="@+id/btnSure"
        android:layout_width="@dimen/dp_195"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/zhuanzhang"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginTop="@dimen/dp_24"
        app:qmui_backgroundColor="@color/account_sel_ok_bg_color"
        app:qmui_borderColor="@color/transparent"
        app:qmui_borderWidth="0px"
        app:qmui_radius="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_add_remark"
        />
</androidx.constraintlayout.widget.ConstraintLayout>