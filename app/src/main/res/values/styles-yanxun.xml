<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--统一项目内的所有Button，共有两种样式(登录注册、充值提现除外)...-->
    <!--宽度为match_parent的Button，背景跟随app主色改变而改变(解散/退出群组、退出当前账号背景固定为红色)-->
    <style name="BossGreenBtn">
        <item name="android:background">@drawable/bg_btn_room</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginLeft">15dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginRight">15dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/sp_16</item>
    </style>



    <style name="CustomCheckBoxTheme" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/circle_group_see</item>
    </style>

    <style name="BottomDialogAnimation" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/translate_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/translate_dialog_out</item>
    </style>

    <style name="BottomDialog" parent="@style/Base.V7.Theme.AppCompat.Light.Dialog">
        <item name="android:background">#00000000</item> <!-- 设置自定义布局的背景透明 -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Notification_Toast">
        <item name="android:windowEnterAnimation">@anim/notification_toast_enter</item>
        <item name="android:windowExitAnimation">@anim/notification_toast_exit</item>
    </style>
</resources>