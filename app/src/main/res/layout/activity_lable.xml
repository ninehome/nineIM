<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/grayf4f5f6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tb_background="@color/grayf4f5f6"
        app:tb_tvRight_text="@string/add"
        app:tb_tvRight_textColor="#FF06D89A"
        app:tb_ivRight_src="@drawable/icon_addition"
        app:tb_tvTitle_text="@string/label" />

    <com.tiocloud.chat.yanxun.view.LineBreakLayout
        android:id="@+id/label_view"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftAndRightSpace="@dimen/dp_16"
        app:rowSpace="@dimen/dp_16"
        />
</LinearLayout>