<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emojiLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray_f9f9f9"
    android:orientation="vertical"
    android:visibility="visible">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/scrPlugin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/layout_scr_bottom"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal" />
    <RadioGroup
        android:id="@+id/face_btn_layout"
        android:layout_width="fill_parent"
        android:layout_height="35dp"
        android:gravity="center"
        android:visibility="visible"
        android:orientation="horizontal">


        <!--            android:background="@drawable/face_chang_bg"
-->
        <RadioButton
            android:id="@+id/default_face"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/face_chang_bg"
            android:layout_weight="1"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="@string/biaoqing" />

        <View
            android:layout_width="0.2dp"
            android:layout_height="match_parent"
            android:background="@color/btn_live_2" />

        <RadioButton
            android:id="@+id/moya_face_gif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/face_chang_bg"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="@string/donghua" />

        <View
            android:layout_width="0.2dp"
            android:layout_height="match_parent"
            android:background="@color/btn_live_2" />

        <RadioButton
            android:id="@+id/collection_emotion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/face_chang_bg"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="@string/zidingyibiaoqing" />

    </RadioGroup>
</LinearLayout>