<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grayf4f5f6"
        android:orientation="vertical">

        <!--状态栏-->
        <FrameLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--标题栏-->
        <com.watayouxiang.androidutils.widget.WtTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tb_background="@color/grayf4f5f6"
            app:tb_tvTitle_text="@string/group_manage" />

        <View
            android:id="@+id/v_groupMgrBottom"
            android:background="@color/gray_e9e9e9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp" />

        <!--开启成员邀请-->
        <RelativeLayout
            android:id="@+id/rl_toggleInviteMember"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/open_member_invitation"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_toggleInviteMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/btn_switch"
                android:layout_marginRight="@dimen/dp_15"
                android:checked="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>

        <!--成员邀请审核-->
        <RelativeLayout
            android:id="@+id/rl_inviteMember_verify"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/member_invitation_check"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_inviteMember_verify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/btn_switch"
                android:layout_marginRight="@dimen/dp_15"
                android:checked="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>

        <!--禁止成员私聊-->
        <RelativeLayout
            android:id="@+id/rl_ban_p2p_chat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/forbiden_member_chat"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_ban_p2p_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/btn_switch"
                android:layout_marginRight="@dimen/dp_15"
                android:checked="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>

        <!--开启成员邀请-->
        <RelativeLayout
            android:id="@+id/rl_ban_member_exit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/forbiden_member_leave_group"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_ban_memeber_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/btn_switch"
                android:layout_marginRight="@dimen/dp_15"
                android:checked="false" />


        </RelativeLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_8"
            android:background="@color/grayf4f5f6"
            />

        <!--全体禁言-->
        <RelativeLayout
            android:id="@+id/rl_banAll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/all_forbiden_language"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_banAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/btn_switch"
                android:layout_marginRight="@dimen/dp_15"
                android:checked="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>
        <!--禁言名单-->
        <RelativeLayout
            android:id="@+id/rl_managerlist"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/appoint_manager"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_forward_item_group" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>
        <!--禁言名单-->
        <RelativeLayout
            android:id="@+id/rl_banList"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:id="@+id/tv_banList_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/forbiden_list"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_banList_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@id/iv_banList_arrow"
                android:layout_toRightOf="@id/tv_banList_title"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/gray_9c9c9c"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:id="@+id/iv_banList_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_forward_item_group" />
        </RelativeLayout>


    </LinearLayout>
</layout>
