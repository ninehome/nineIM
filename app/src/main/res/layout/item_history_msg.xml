<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        >

        <!--头像-->
        <com.watayouxiang.androidutils.widget.imageview.TioImageView
            android:id="@+id/tiv_avatar"
            android:layout_width="@dimen/avatar_wh_48"
            android:layout_height="@dimen/avatar_wh_48"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            app:roundAsCircle="true"
            android:layout_centerVertical="true"
            />

        <FrameLayout
            android:id="@+id/content_fl"
            android:layout_toRightOf="@id/tiv_avatar"
            android:layout_marginLeft="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_e9e9e9"
            />

    </RelativeLayout>

</layout>