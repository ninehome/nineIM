<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/white"
    android:foreground="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkBox"
        style="@style/TioCheckboxTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_centerVertical="true"
         />

    <com.watayouxiang.androidutils.widget.imageview.TioImageView
        android:id="@+id/hiv_avatar"
        android:layout_width="@dimen/dp40"
        android:layout_height="@dimen/dp40"
        app:roundAsCircle="true"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_toRightOf="@id/checkBox"
        android:layout_centerVertical="true"
        />

    <LinearLayout
        android:id="@+id/ll_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toRightOf="@id/hiv_avatar"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="15dp"
        android:layout_centerVertical="true"
        >


        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/test_name"
            android:textColor="@color/gray_333333"
            android:textSize="@dimen/sp_16"
            />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:text="昵称: watayouxiang"
            android:textColor="@color/gray_909090"
            android:textSize="@dimen/sp_12"
            />

    </LinearLayout>

    <View
        android:id="@+id/v_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9"
        android:layout_toRightOf="@id/hiv_avatar"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="15dp"
        />

    <View
        android:id="@+id/v_divider1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        />




</RelativeLayout>