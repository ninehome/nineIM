<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!--群成员列表-->

        <!--查看全部成员-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_memberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="@dimen/dp_2"
            android:paddingRight="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_2" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/ll_viewAllMember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/dp_15"
                android:paddingTop="@dimen/dp_15"
                android:paddingRight="@dimen/dp_15"
                android:paddingBottom="@dimen/dp_15">

                <TextView
                    android:id="@+id/tv_viewAllMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="查看更多群成员(0)"
                    android:textColor="@color/gray_666666"
                    android:textSize="@dimen/sp_14" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:src="@mipmap/icon_arrowr_gray" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:background="@color/grayf4f5f6"
            android:layout_height="@dimen/dp_8" />

        <!--群名称-->
        <LinearLayout
            android:id="@+id/ll_groupName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_name"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_groupName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:id="@+id/iv_arrow_groupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>
        <View
            android:id="@+id/view_avatar_line"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp15"
            android:background="@color/gray_e9e9e9" />
        <!--群头像-->
        <LinearLayout
            android:id="@+id/ll_avatar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_head"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:id="@+id/iv_arrow_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:background="@color/gray_e9e9e9" />

        <!--群简介-->
        <LinearLayout
            android:id="@+id/ll_groupIntro"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_intro"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_groupIntro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:background="@color/gray_e9e9e9" />

        <!--群公告-->
        <LinearLayout
            android:id="@+id/ll_groupNotice"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_notice"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_groupNotice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:background="@color/gray_e9e9e9" />

        <!--群主-->
        <LinearLayout
            android:id="@+id/ll_groupOwner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_owner"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_groupOwner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:background="@color/gray_e9e9e9" />

        <!--群二维码-->
        <RelativeLayout
            android:id="@+id/rl_QRCode"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="15dp"
                android:text="@string/group_qrcode"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/iv_qrcode_arrow"
                android:src="@drawable/icon_myma" />

            <ImageView
                android:id="@+id/iv_qrcode_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_8"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e6e6e6" />
        </RelativeLayout>

        <!--我的群昵称-->
        <LinearLayout
            android:id="@+id/ll_groupNick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_nick_on_group"
                android:textStyle="bold"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_groupNick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/gray_666666"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/dp_15"
            android:background="@color/gray_e9e9e9" />
        <RelativeLayout
            android:id="@+id/rl_toggleInviteMember"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/message_no_disturb"
                android:textStyle="bold"
                android:textColor="@color/gray_111111"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/switch_no_distrub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_15"
                android:button="@drawable/btn_switch"
                android:checked="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:background="@color/grayf4f5f6"
            android:visibility="gone"
            android:layout_height="@dimen/dp_8" />

        <!--群管理-->
        <RelativeLayout
            android:id="@+id/rl_groupMgr"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/group_manage"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_8"
            android:background="@color/grayf4f5f6"
            />


        <!--清除聊天记录-->
        <RelativeLayout
            android:id="@+id/rl_deleteChatRecord"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/clear_chat_history"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_alignParentBottom="true"
                android:background="@color/gray_e9e9e9" />
        </RelativeLayout>

        <!--投诉-->
        <RelativeLayout
            android:id="@+id/rl_complaint"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_58"
            android:background="@drawable/tio_user_item_bg"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:text="@string/tousu"
                android:textColor="#FF252A31"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_15"
                android:layout_marginLeft="8dp"
                android:src="@mipmap/icon_arrowr_gray" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/grayf4f5f6"
            />

    </LinearLayout>
</ScrollView>
