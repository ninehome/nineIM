<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:foreground="?attr/selectableItemBackground"
    android:id="@+id/cl_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <!--头像-->
    <com.watayouxiang.androidutils.widget.imageview.TioImageView
        android:id="@+id/v_avatar"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_6"
        app:roundAsCircle="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--昵称-->
    <TextView
        android:id="@+id/v_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_12"
        android:singleLine="true"
        android:text="@string/test_name"
        android:layout_marginTop="3dp"
        android:textColor="@color/gray_333333"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/tv_time"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/v_avatar"
        app:layout_constraintTop_toTopOf="@id/v_avatar" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_online_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:textColor="@color/theme_color"
        android:textSize="10sp"
        android:text="离线"
        android:background="@drawable/dot_offline_bg"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@id/v_avatar"
        app:layout_constraintTop_toTopOf="@id/v_avatar"
        />


    <!--消息-->
    <TextView
        android:id="@+id/v_recent_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_42"
        android:singleLine="true"
        tools:text="1111111111111111111111111111111111111111111111111111111111111111111111111111111111111"
        android:textColor="@color/gray_888888"
        android:textSize="@dimen/sp_14"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/v_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/v_name"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="3dp"
        />

    <!--时间-->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_15"
        android:text="@string/test_time"
        android:textColor="@color/gary_b5b5b5"
        android:textSize="@dimen/sp_12"
        app:layout_constraintBottom_toBottomOf="@id/v_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/v_name" />


    <!--未读消息数-->
    <com.tiocloud.chat.widget.textview.ListUnreadTextView
        android:id="@+id/tv_unreadMsgNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/one"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/v_recent_msg"
        android:layout_marginRight="15dp"
        app:layout_constraintTop_toTopOf="@id/v_recent_msg"
        />
    <View
        android:id="@+id/tv_notrub_msg"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/selector_online"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginRight="15dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_unreadMsgNum"
        app:layout_constraintTop_toTopOf="@id/tv_unreadMsgNum"
        app:layout_constraintStart_toStartOf="@id/tv_unreadMsgNum"
        />
    <!--在线状态-->
    <View
        android:id="@+id/v_status"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_margin="3dp"
        android:background="@drawable/online_selector2"
        app:layout_constraintEnd_toEndOf="@id/v_avatar"
        app:layout_constraintTop_toTopOf="@id/v_avatar"  />




    <!--置顶标记-->
    <ImageView
        android:id="@+id/iv_topFlag"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/label_zhiding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--分割线-->
    <View
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@id/v_name" />



</androidx.constraintlayout.widget.ConstraintLayout>