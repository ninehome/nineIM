<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grayf4f5f6"
    android:orientation="vertical">

    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tb_background="@color/grayf4f5f6"
        app:tb_tvTitle_text="@string/new_label" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:paddingLeft="15dp"
        android:text="@string/label_name"
        android:textColor="#FFB3B3B3"
        android:textSize="@dimen/sp_14" />

    <EditText
        android:id="@+id/label_name_et"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_15"
        android:background="@drawable/grop_dialog_bg"
        android:ellipsize="end"
        android:hint="@string/lirujiaren"
        android:paddingLeft="10dp"
        android:paddingRight="@dimen/dp_10"
        android:singleLine="true"
        android:textColor="#BDBDBD"
        android:textSize="@dimen/sp_16" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:background="@color/gray_e9e9e9"
        />
    <LinearLayout
        android:id="@+id/add_label_user"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:layout_alignParentRight="true"
        android:background="@color/white"

        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_add_people"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/icon_addition" />

        <TextView
            android:id="@+id/tv_add_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="@dimen/dp_20"
            android:gravity="center_vertical"
            android:text="@string/add_member"
            android:textColor="#FF06D89A"
            android:textSize="@dimen/sp_16" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        >

        <TextView
            android:id="@+id/label_user_size"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="15dp"
            android:text="@string/tag_member0"
            android:textColor="#FFB3B3B3"
            android:textSize="@dimen/sp_14" />



    </RelativeLayout>

    <View
        android:id="@+id/line1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:textColor="@color/gray_e9e9e9"
        android:visibility="visible" />

    <com.tiocloud.chat.yanxun.view.PullToRefreshSlideListView
        android:id="@+id/pull_refresh_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:showDividers="none"
        app:ptrAnimationStyle="flip"
        app:ptrDrawableEnd="@drawable/default_ptr_rotate"
        app:ptrDrawableStart="@drawable/default_ptr_flip"
        app:ptrHeaderTextColor="@color/black"
        app:ptrMode="both"
        app:ptrOverScroll="false"
        app:ptrScrollingWhileRefreshingEnabled="true"
        app:ptrShowIndicator="false"
        app:slideMode="right"
        app:slideRightAction="reveal" />

    <View
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9"
        />

</LinearLayout>