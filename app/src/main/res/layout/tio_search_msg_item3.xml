<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/layer_list_side"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="horizontal">

    <com.watayouxiang.androidutils.widget.imageview.TioImageView
        android:id="@+id/hiv_avatar"
        android:layout_width="@dimen/avatar_wh_44"
        android:layout_height="@dimen/avatar_wh_44"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_6"
        app:roundAsCircle="true"
        android:layout_marginBottom="@dimen/dp_6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/test_name"
            android:textColor="@color/gray_333333"
            android:textSize="@dimen/sp_16" />

    </LinearLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/arrow_right"
        android:paddingRight="@dimen/dp_15"
        />
</LinearLayout>