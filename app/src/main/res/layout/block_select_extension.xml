<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        >
<!--        android:background="@drawable/shape_round_white_bg2"-->
        <LinearLayout
            android:id="@+id/ll_group"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="15dp"
            android:background="@drawable/ripple_corner_top"
            >

            <TextView
                android:id="@+id/tvLabel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/gray_333333"
                android:textSize="16sp"
                android:text="@string/xuanze_group_zhuanfa"
                />

            <TextView
                android:id="@+id/tvValue1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/Grey_400"
                android:textSize="12sp"
                android:visibility="gone"
                android:text="选择群组群发"
                 />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_e9e9e9"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15"
            />
        <LinearLayout
            android:id="@+id/ll_label"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/ripple_corner_bottom"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="15dp"
            >

            <TextView
                android:id="@+id/tvLabel2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/gray_333333"
                android:textSize="16sp"
                android:text="@string/xuanze_label_zhuanfa"
                android:textStyle="normal"/>

            <TextView
                android:id="@+id/tvValue2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/Grey_400"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="选择标签群发"
                 />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>

                