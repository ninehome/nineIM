<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_f4f5f6"
    android:orientation="vertical">

    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tb_isLightMode="true"
        app:tb_background="@color/gray_f4f5f6"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        >

        <TextView
            style="@style/AccountTitle"
            android:textStyle="bold"
            android:text="@string/mian_disturb" />

        <CheckBox
            android:id="@+id/no_disturb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:button="@drawable/btn_switch"
            android:checked="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_e9e9e9"
            android:layout_marginLeft="15dp"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>



    <RelativeLayout
        android:id="@+id/rl_new_information"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        android:paddingLeft="15dp"
        >

        <TextView
            style="@style/AccountTitle"
            android:textStyle="bold"
            android:text="@string/new_message_inform" />

        <ImageView
            android:id="@+id/iv_wallet2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_arrowr_gray" />

        <CheckBox
            android:id="@+id/switch_new_information"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:button="@drawable/btn_switch"
            android:checked="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_e9e9e9"
            android:layout_marginLeft="15dp"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_voice"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        android:paddingLeft="15dp"
        >

        <TextView
            style="@style/AccountTitle"
            android:textStyle="bold"
            android:text="@string/voice" />

        <CheckBox
            android:id="@+id/switch_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:button="@drawable/btn_switch"
            android:checked="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_e9e9e9"
            android:layout_marginLeft="15dp"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_shake"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        android:paddingLeft="15dp"
        >

        <TextView
            style="@style/AccountTitle"
            android:textStyle="bold"
            android:text="@string/shake" />

        <CheckBox
            android:id="@+id/switch_shake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:button="@drawable/btn_switch"
            android:checked="false" />


    </RelativeLayout>



</LinearLayout>