<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!--<include layout="@layout/a_view_actionbar" />-->
    <com.watayouxiang.androidutils.widget.WtTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tb_tvRight_background="@drawable/sel_titlebar_ok_multichoose"
        app:tb_tvRight_enable="false"
        app:tb_tvRight_text="@string/confirm"
        app:tb_tvRight_textColor="@color/grayf4f5f6"
        app:tb_background="@color/grayf4f5f6"
        app:tb_tvTitle_text="@string/choose_group_chat" />
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_e9e9e9"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_select_chat">

    </androidx.recyclerview.widget.RecyclerView>



    <View
        style="@style/View_Line"
        android:visibility="gone" />

    <!--<LinearLayout-->
    <!--android:id="@+id/llSelectedCount"-->
    <!--android:layout_width="match_parent"-->
    <!--android:layout_height="wrap_content"-->
    <!--android:orientation="horizontal"-->
    <!--android:padding="16dp"-->
    <!--android:visibility="gone">-->

    <!--<TextView-->
    <!--android:id="@+id/tvSelectedCount"-->
    <!--android:layout_width="wrap_content"-->
    <!--android:layout_height="wrap_content"-->
    <!--android:text="@string/migrate_chat_count_place_holder" />-->

    <!--</LinearLayout>-->

    <View style="@style/View_Line" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:enabled="false"
            android:text="@string/select_all"
            android:textColor="@color/main_color"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSelectFinish"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:enabled="false"
            android:gravity="center"
            android:text="@string/finish"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:visibility="visible" />

    </RelativeLayout>

</LinearLayout>