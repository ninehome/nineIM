            android:launchMode="singleTop"
            android:theme="@style/TioTheme"
            />

        <activity android:name=".feature.account.pwd.OtherModifyPwdActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/TioTheme"
            />

        <activity android:name=".feature.account.safe.UnBindActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/TioTheme"
            />

        <activity android:name=".feature.account.safe.UnBindActivityOther"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/TioTheme"
            />

        <activity android:name=".feature.account.safe.BindActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/TioTheme"
            />


        <service
            android:name="com.baidu.location.f"
            android:enabled="true"
            android:process=":remote" />
        <service
            android:name=".service.LiveSerice"
            android:enabled="true"
             />
        <meta-data
            android:name="com.baidu.lbsapi.API_KEY"
            android:value="tdjrCcNMluQBziW4oF8fqVcOOvLP6UQL" />
    </application>

</manifest>
